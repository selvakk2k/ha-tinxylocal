{
  "domain": "tinxylocal",
  "name": "Tinxy Local (LAN)",
  "codeowners": [
    "@selvakk2k"
  ],
  "config_flow": true,
  "description": "Fast, 100% local LAN integration for Tinxy Smart Devices.",
  "dependencies": [
    "network"
  ],
  "documentation": "https://github.com/selvakk2k/ha-tinxylocal/blob/main/README.md",
  "issue_tracker": "https://github.com/selvakk2k/ha-tinxylocal/issues",
  "iot_class": "local_polling",
  "zeroconf": [
    {
      "name": "tinxy*",
      "type": "_http._tcp.local."
    }
  ],
  "version": "3.0.0-beta.1",
  "homeassistant": ">=2024.12.0"
}
